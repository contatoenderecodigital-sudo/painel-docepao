# ============================================================================
#  CHAVES DO SISTEMA — copie este arquivo pra .env.local e preencha.
#  NUNCA comitar .env.local (as chaves de verdade). Só este .example vai pro git.
# ============================================================================

# --- Banco (PostgreSQL gerenciado do Supabase) ---
# ⚠️ NO VERCEL: use a string do CONNECTION POOLER (porta 6543, modo Transaction),
# NÃO a conexão direta (5432). Pega em Supabase > Project Settings > Database >
# Connection string > "Transaction pooler".
DATABASE_URL=postgres://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# (Supabase exige SSL — já é o padrão no código. PGSSL=0 só pra Postgres local.)

# --- IA (OpenAI, padrão) ---
# Chave da API. Pega em platform.openai.com > API Keys
OPENAI_API_KEY=sk-...
# Modelo do atendimento. Padrão GPT-4o-mini (barato + tool use confiável). Trocável.
MODELO_IA=gpt-4o-mini
# (Opcional) apontar pra outro provedor compatível (Gemini/DeepSeek/OpenRouter)
# sem mudar código. Deixe em branco pra usar a OpenAI.
# OPENAI_BASE_URL=

# --- Login do painel ---
# Segredo pra assinar o cookie de sessão. Gere um aleatório longo e NÃO mude
# (mudar desloga todo mundo). Ex: openssl rand -hex 32
SESSION_SECRET=troque-por-um-hex-aleatorio-de-64-caracteres

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=...
# Palavra secreta pra validar o webhook (você inventa; a mesma vai no painel do Meta).
WHATSAPP_VERIFY_TOKEN=docepao-webhook-2026
# Negócio padrão (Doce Pão) enquanto só tem 1 cliente. Depois o webhook resolve
# pelo phone_number_id (negocios.config->>whatsapp_phone_id). É o id do seed.
NEGOCIO_PADRAO_ID=11111111-1111-1111-1111-111111111111

# --- Ponte de impressão (autenticação da API que a ponte consome) ---
# Token secreto que a ponte manda no header pra puxar a fila. Você inventa.
PONTE_TOKEN=troque-por-um-token-secreto-da-ponte

# --- Transcrição de áudio (STT) ---
# A dona pediu: a IA ouve áudio e responde em texto. Whisper transcreve.
# Provider: openai ou groq. Deixe em branco enquanto não escolher.
STT_PROVIDER=
STT_API_KEY=
